---
import { siteConfig } from '../config';
---

<section id="about" class="about">
  <div class="container">
    <div class="about-content">
      <div class="about-text">
        <h2>About {siteConfig.companyName}</h2>
        <p class="lead">
          We're on a mission to revolutionize the way businesses operate through
          innovative technology solutions.
        </p>
        <p>
          Founded by industry experts with decades of combined experience, we understand
          the challenges modern businesses face. Our platform is built from the ground up
          to address these challenges with elegant, powerful solutions.
        </p>
        <p>
          Whether you're a startup finding your footing or an enterprise scaling to new
          heights, we provide the tools and support you need to succeed.
        </p>
        <div class="about-stats">
          <div class="stat">
            <div class="stat-number">10K+</div>
            <div class="stat-label">Active Users</div>
          </div>
          <div class="stat">
            <div class="stat-number">50+</div>
            <div class="stat-label">Countries</div>
          </div>
          <div class="stat">
            <div class="stat-number">99.9%</div>
            <div class="stat-label">Uptime</div>
          </div>
        </div>
      </div>
      <div class="about-image">
        <div class="image-placeholder">
          <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
            <rect x="0" y="0" width="400" height="400" rx="20" fill="#764ba2" opacity="0.1"></rect>
            <circle cx="200" cy="150" r="60" fill="#764ba2" opacity="0.3"></circle>
            <rect x="100" y="230" width="200" height="15" rx="7.5" fill="#764ba2" opacity="0.4"></rect>
            <rect x="80" y="260" width="240" height="15" rx="7.5" fill="#764ba2" opacity="0.3"></rect>
            <rect x="120" y="290" width="160" height="15" rx="7.5" fill="#764ba2" opacity="0.2"></rect>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>
