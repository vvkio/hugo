---
import { siteConfig } from '../config';
---

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <h1 class="hero-title">{siteConfig.companyName}</h1>
      <p class="hero-tagline">{siteConfig.tagline}</p>
      <p class="hero-description">
        Empowering businesses with innovative solutions that drive growth,
        increase efficiency, and transform the way you work.
      </p>
      <div class="hero-buttons">
        <a href="#" class="btn btn-primary btn-lg">Start Free Trial</a>
        <a href="#" class="btn btn-secondary btn-lg">Watch Demo</a>
      </div>
    </div>
    <div class="hero-image">
      <div class="hero-illustration">
        <!-- Placeholder for illustration -->
        <svg viewBox="0 0 500 400" xmlns="http://www.w3.org/2000/svg">
          <rect x="50" y="50" width="400" height="300" rx="20" fill="#667eea" opacity="0.1"></rect>
          <rect x="80" y="80" width="340" height="240" rx="15" fill="#667eea" opacity="0.2"></rect>
          <circle cx="250" cy="200" r="80" fill="#667eea" opacity="0.3"></circle>
          <path d="M 200 200 L 250 150 L 300 200 L 250 250 Z" fill="#667eea"></path>
        </svg>
      </div>
    </div>
  </div>
</section>
