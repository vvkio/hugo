---
import { siteConfig } from '../config';
---

<section class="cta">
  <div class="container">
    <div class="cta-content">
      <h2>Ready to Get Started?</h2>
      <p>Join thousands of businesses already using {siteConfig.companyName} to grow and scale</p>
      <div class="cta-buttons">
        <a href="#" class="btn btn-primary btn-lg">Start Free Trial</a>
        <a href="#contact" class="btn btn-secondary btn-lg">Contact Sales</a>
      </div>
      <p class="cta-note">No credit card required • 14-day free trial • Cancel anytime</p>
    </div>
  </div>
</section>
